{
  "$schema": "https://x18n.dev/schema/config.json",
  "sourceLocale": "en",
  "resources": [
    {
      "pattern": "messages/{locale}.json",
      "namespace": "core"
    }
  ],
  "namespace": {
    "separator": ":",
    "default": "core",
    "byFile": {
      "demo/**": "demo",
      "src/svelte/**": "demo"
    },
    "fallback": [
      "core"
    ]
  },
  "keyStyle": "flat",
  "plugins": [
    "./.x18n/placeholders.x18n-plugin.yml"
  ],
  "usage": {
    "include": [
      "app/**"
    ],
    "calls": [
      {
        "callee": "t"
      },
      {
        "callee": "editor.t"
      }
    ],
    "derivedKeys": [
      "{key}.{plural}"
    ]
  },
  "checks": {
    "missing-translation": "error",
    "empty-translation": "error"
  },
  "ignoreKeys": [
    "core:card.tibetan",
    "core:card.variantForms",
    "core:card.variantFormsPartial",
    "core:card.variantOf",
    "core:card.variantOfPartial",
    "core:card.variantPossible",
    "core:card.variantReported",
    "core:card.variantReportedSource",
    "core:card.variantsPossibleSource",
    "core:card.variantsSource",
    "core:chart.tone.unknown",
    "core:codes.block.components",
    "core:codes.block.supplement",
    "core:codes.block.supplementComponents",
    "core:codes.block.tangut",
    "core:eras.contemporary.tab",
    "core:eras.tab.later",
    "core:eras.tab.posthumous",
    "core:eras.tab.states",
    "core:eras.tab.titles",
    "core:find.door.cangjie",
    "core:find.door.chart",
    "core:find.door.draw",
    "core:find.door.fanqie",
    "core:find.door.meaning",
    "core:find.door.parts",
    "core:find.door.reading",
    "core:find.door.sijiao",
    "core:find.door.transcribe",
    "core:font.kai",
    "core:font.serif",
    "core:font.wenhai",
    "core:font.yinchuan",
    "core:gyalrongic.hint",
    "core:nav.cangjie.hint",
    "core:nav.chart.hint",
    "core:nav.codes.hint",
    "core:nav.draw.hint",
    "core:nav.eras",
    "core:nav.eras.hint",
    "core:nav.fanqie.hint",
    "core:nav.find",
    "core:nav.find.hint",
    "core:nav.find.tab",
    "core:nav.group.sense",
    "core:nav.group.sense.tab",
    "core:nav.group.shape",
    "core:nav.group.shape.tab",
    "core:nav.group.sound",
    "core:nav.group.sound.tab",
    "core:nav.group.text",
    "core:nav.group.text.tab",
    "core:nav.intro",
    "core:nav.intro.hint",
    "core:nav.meaning.hint",
    "core:nav.parts.hint",
    "core:nav.reading.hint",
    "core:nav.sijiao",
    "core:nav.sijiao.hint",
    "core:nav.texts.hint",
    "core:nav.transcribe.hint",
    "core:palette.indigo",
    "core:palette.mineral",
    "core:palette.paper",
    "core:palette.sand",
    "core:reading.tone.any",
    "core:reading.tone.level",
    "core:reading.tone.rising",
    "core:texts.edition",
    "core:texts.lausanne",
    "core:texts.wikisource"
  ]
}
