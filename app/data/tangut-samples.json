    {
      "id": "twenty-five-questions",
      "sourceId": "wikisource-twenty-five-questions",
      "sourceTitle": "Twenty-five Questions",
      "sourceUrl": "https://wikisource.org/wiki/%F0%97%B9%8C%F0%98%90%98%F0%97%8D%AB%F0%97%B0%97%F0%97%8F%81%F0%97%A4%84%F0%97%8A%AC",
      "licence": "CC BY-SA 4.0",
      "label": "Question 1",
      "famous": false,
      "lineIds": [
        "wikisource-twenty-five-questions:q1"
      ],
      "text": "𘈒𗤄：𗢳𘒣：「𗎫𘟀𗢳𗵆」𘘣𗫂𘌽𗧘𘝶𗦜？𘘚𘒣：𗰜𗎫𗮔𗩱𗫂，𘟀𘟂。𗰜𗎫𘟀𗩱，𘟀𘟣𗦇𗤋𗫂，𗮔𘟂。𗮔𗰜𗋕𗡶，𘉐𗭍𗅋𗋃𗫂，𗎫𘟂。𘌽𗍊𗎫𘟀𗗙𗢳𗵆𘘣𘃞。𗅉𗤄：𘎳𗫻𘁟𗈞𗥃𘍦𗧘𗫂，𘓂𘙌𘟂？𘘚𘒣：𗈪𗆫𘟀𗩱，𗌭𘎳𗧘𘟂；𘟀𘘂𘟀𘙇𗫡𗢳𗵆𗫂，𗫻𗧘𘟂。𘓷𘟀𗎫𘟂。𗎫𗫂𗵘𘟂；𗵘𗫂𘉐𘟂；𘉐𗫂𗢳𘟂。𘌽𗫂𘁟𗧘𘟂。𗎫𘟀𗰜𘖀𗲠𗘺，𘟀𗦇𗅋𘟣，𘟀𘝵𘟀𗤋，𘘦𗈞𗧘𘟂。𗤄𗇋𘌽𗓨𗪲𗒐𘒩𘕤。"
    },
    {
      "id": "dragon-king",
      "sourceId": "wikisource-dragon-king",
      "sourceTitle": "Dragon King’s question",
      "sourceUrl": "https://wikisource.org/wiki/%F0%97%A2%B3%F0%97%97%9A%F0%97%B5%83%F0%98%9F%99%F0%97%97%99%F0%97%B9%99%F0%98%9F%A9%F0%98%92%A3%F0%97%96%B0%F0%97%9A%A9",
      "licence": "CC BY-SA 4.0",
      "label": "line 1",
      "famous": false,
      "lineIds": [
        "wikisource-dragon-king:line-1"
      ],
      "text": "𘌽𗍊𗔘𗧓：𘃞𗿳𗣧𘀺𗏆𘜶𗗚𗵃𘟙𗎭𗅁𗫻，𘜶𗁡𗳷𗫔𗡞𗍫𘊝𗏁𗰗𘓐，𗅉𗱕𘏞𗢈𗓚𘄽𗢈𗫔𗄭。𗉘𘝨𗦗𘀺𗓽𗵃𘟙𗶠𘏚𗈪𗢵，𗢳𗺌𗗙𗍺𘐔，𗢳𗗙𘒣𘘥：「𗯨𗖻！𘓊𗰣𗹙𗒐𗧯𘔼，𗮅𗧸𗼕𗱱𗈪𗉘𘜘？」𘘣𗢳𗗚𗵃𘟙𗗙𘘥：「𗥃𘋠𗠁𘍳𗹙𘟣，𘎤𗓱𗒐𗧯、𗗈𘆖、𗧘𗖵𗄻𗥤𗌭，𘟏𗪺𘙌𘜶□□𗢼，𗮅𗼕𗣼𘜘，𘉋𗕑𗥃𗡞𗹙𗔇𗗈𘆖𗣼𘉐𗑠𗈪𗅲𗅋𘁟。𗥃𗫂𘓇𘙌𘟂？𘌽𗫂：𗱕𘝦𗅋𗏹、𗄑𗄑𗄊𘍔、𗱕𗹙𗧓𗤋、𗘺𗈞𗴴𗨻。𗆫𘆖𗦇𗵃𘟙！𘌽𗫂𗥃𘋠𗠁𘍳𗹙𘟂，𘏞𗢈𗓚𘄽𗢈𘌽𘕾𗅋𗋃𗹙𘄡𘜘，𗉮𘃛𘎳𗤋𘕥，𘜤𘍞𗘺𘕿𗫡，𘌽𘔼𗍳𘆄𗏹𗆫𘆖𗦇。」𗉘𘝨𗯨𗖻□𗥃𗣃𗹙𘟩𗖰𗚩𘎪，□□□𗓁、𘜶𘋢𗥤𗫔，𗅉𘓱𗵃𘉋𗴮、𗠝𘏱𗓽、𘀺□□□，□□□□，□□□□，□□𗡶𗭍。"
    },
