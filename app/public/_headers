# The build names every asset after its content, so a year is safe and a repeat visit fetches nothing.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The faces keep their names across builds, so they are kept for a week rather than forever.
/fonts/*
  Cache-Control: public, max-age=604800

/facsimile/*
  Cache-Control: public, max-age=604800
